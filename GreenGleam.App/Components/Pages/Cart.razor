@inject AuthService authService
@inject CartService cartService
@inject IUserApi userApi
@inject NavigationManager navigationManager
@page "/cart"


<SectionContent SectionName="pageTitle">
    Cart
</SectionContent>
<SectionContent SectionName="toolbarItem">
    <button @onclick="cartService.ClearCartAsync"
            class="flex items-center justify-center rounded-lg bg-blue-500 p-2 text-white shadow transition hover:bg-blue-600 active:scale-95">
        <i class="fa-solid fa-trash-can"></i>
    </button>
</SectionContent>


<div class="space-y-3">
    @if (cartService.Count == 0)
    {
        @if (cartService.CartItems.Count == 0)
        {
            <div class="mt-5 flex h-full flex-col items-center justify-center space-y-4 text-center">
                <i class="fa-solid fa-cart-shopping text-7xl text-gray-300"></i>
                <div>
                    <p class="text-lg font-semibold text-gray-700">Your cart is empty</p>
                    <p class="text-sm text-gray-500">Looks like you haven’t added anything yet.</p>
                </div>
                <NavLink href="/" class="rounded-lg bg-blue-500 px-6 py-2 text-sm font-medium text-white shadow active:bg-blue-600">
                    Continue Shopping
                </NavLink>
            </div>
        }
    }
    else
    {
        <!-- Cart Items -->
        @foreach (var item in cartService.CartItems)
        {
            <div class="flex items-start justify-between rounded-xl bg-white p-4 shadow-md">
                <div class="flex items-center gap-4">
                    <img alt="@item.Name" class="h-16 w-16 rounded-lg object-cover" src="@item.Image" />
                    <div class="flex h-full flex-col justify-between space-y-2">
                        <div>
                            <span class="font-semibold text-gray-800">@item.Name</span>
                            <span class="block text-sm text-gray-500">
                                @item.Price.ToString("C") / @item.Unit
                            </span>
                        </div>
                        <div class="mt-1 flex items-center space-x-1">
                            <button @onclick="() => cartService.DecreaseCartItemQuantity(item)" class="flex h-7 w-7 items-center justify-center rounded border border-blue-500 text-blue-500 active:bg-blue-500 active:text-white">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <span class="w-6 text-center text-sm font-medium">
                                @item.Quantity
                            </span>
                            <button @onclick="() => cartService.IncreaseCartItemQuantity(item)" class="flex h-7 w-7 items-center justify-center rounded border border-blue-500 text-blue-500 active:bg-blue-500 active:text-white">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col justify-between">
                    <button @onclick="() => cartService.RemoveCartItem(item)" class="text-gray-400 hover:text-red-500">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <span class="text-sm font-semibold text-gray-800">
                        @item.Total.ToString("C")
                    </span>
                </div>
            </div>
        }
    }

    <!-- Checkout section at the bottom (only visible if cart has items) -->
    @if (cartService.Count > 0)
    {
        <div @onclick="ContinueAsync" class="sticky bottom-0 z-40 rounded-xl border border-neutral-200 bg-white p-4">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-sm font-medium text-gray-500">
                        TOTAL ITEMS: @cartService.Count
                    </span>
                    <span class="block text-lg font-bold text-gray-800">
                        @cartService.TotalAmount.ToString("C")
                    </span>
                </div>
                <button class="rounded-lg bg-blue-500 px-6 py-2 text-white active:bg-blue-600">
                    Continue
                </button>
            </div>
        </div>
    }
</div>


@code {
    private AddressDto[] addressListDto { get; set; } = Array.Empty<AddressDto>();

    private async Task ContinueAsync()
    {
        if (!authService.IsLoggedIn)
        {
            authService.RedirectFromLogin = "/cart";
            navigationManager.NavigateTo("/login");
            return;
        }

        if (addressListDto.Length == 0)
        {
            addressListDto = await userApi.GetAddressesAsync();

            if (addressListDto.Length == 0)
            {
                if (await MauiInterop.ConfirmAsync("Please add an address before proceeding to checkout.", "No address found"))
                {
                    navigationManager.NavigateTo("/manage-addresses");
                    return;
                }
            }
        }

        navigationManager.NavigateTo("/place-order");
    }
}