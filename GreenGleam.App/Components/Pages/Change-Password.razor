@layout EmptyLayout
@inject AppState appState
@inject IUserApi userApi
@inject NavigationManager navigationManager
@page "/change-password"


<div class="flex min-h-screen items-center justify-center bg-gray-50">
    <div class="w-full max-w-sm rounded-xl bg-white p-6 shadow-lg">
        <!-- Header -->
        <div class="mb-6 text-center">
            <h1 class="mt-2 text-xl font-bold text-gray-800">Change Password</h1>
            <p class="text-sm text-gray-500">Update your account security</p>
        </div>

        <!-- Form -->
        <EditForm Model="changePasswordDto" class="space-y-4" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator/>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Current Password</label>
                <InputText @bind-Value="changePasswordDto.CurrentPassword" type="password" placeholder="Enter current password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
                <ValidationMessage For="() => changePasswordDto.CurrentPassword" class="flex items-center gap-1 text-xs text-red-500" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">New Password</label>
                <InputText @bind-Value="changePasswordDto.NewPassword" type="password" placeholder="Enter new password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
                <ValidationMessage For="() => changePasswordDto.NewPassword" class="flex items-center gap-1 text-xs text-red-500" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Confirm New Password</label>
                <InputText @bind-Value="changePasswordDto.ConfirmNewPassword" type="password" placeholder="Confirm new password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
                <ValidationMessage For="() => changePasswordDto.ConfirmNewPassword" class="flex items-center gap-1 text-xs text-red-500" />
            </div>

            <div class="space-y-3">
                <button type="submit" class="w-full rounded-lg bg-blue-500 py-2 text-sm font-medium text-white shadow-md transition hover:bg-blue-600 focus:ring-2 focus:ring-blue-400 focus:outline-none">
                    Save    
                </button>
                <button @onclick="Back" type="button" class="w-full rounded-lg border border-gray-300 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-100 focus:ring-2 focus:ring-blue-400 focus:outline-none">
                    Back
                </button>
            </div>
        </EditForm>
    </div>
</div>


@code {
    private ChangePasswordDto changePasswordDto = new();

    private async Task SaveAsync()
    {
        appState.ShowLoader();

        try
        {
            var apiResult = await userApi.ChangePasswordAsync(changePasswordDto);
            if (!apiResult.IsSuccess)
            {
                await Snackbar.Make(apiResult.Error).Show();
                return;
            }

            await Snackbar.Make("Password changed successfully").Show();
            navigationManager.NavigateTo("/profile", replace: true);
        }
        catch (Exception ex)
        {
            await Snackbar.Make(ex.Message).Show();
        }
        finally
        {
            appState.HideLoader();
        }
    }

    private void Back()
    {
        navigationManager.NavigateTo("/profile");
    }
}