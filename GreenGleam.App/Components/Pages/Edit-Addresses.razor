@page "/edit-addresses"

<SectionContent SectionName="pageTitle">
    Edit Addresses 
</SectionContent>


<div class="flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-lg">
        <!-- Header -->
        <div class="mb-6 text-center">
            <h1 class="mt-2 text-xl font-bold text-gray-800">Edit Addresses</h1>
            <p class="text-sm text-gray-500">Add or update your delivery addresses</p>
        </div>

        <!-- Address Form -->
        <div class="space-y-4">
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Full Name</label>
                <input type="text" placeholder="Enter full name"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                              focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Mobile Number</label>
                <input type="tel" placeholder="Enter mobile number"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                              focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Address Line</label>
                <input type="text" placeholder="Street, building, etc."
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                              focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">City</label>
                    <input type="text" placeholder="City"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                                  focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">Postal Code</label>
                    <input type="text" placeholder="Postal Code"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                                  focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
                </div>
            </div>

            <!-- Save Button -->
            <button type="button"
                    class="w-full rounded-lg bg-blue-500 py-2 text-sm font-medium text-white shadow-md
                           transition hover:bg-blue-600 focus:ring-2 focus:ring-blue-400 focus:outline-none">
                Save Address
            </button>
        </div>
    </div>
</div>


