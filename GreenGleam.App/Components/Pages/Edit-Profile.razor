@page "/edit-profile"


<SectionContent SectionName="pageTitle">
    Edit Profile
</SectionContent>


<div class="flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-lg">
        <!-- Header -->
        <div class="mb-6 text-center">
            <h1 class="mt-2 text-xl font-bold text-gray-800">Edit Profile</h1>
            <p class="text-sm text-gray-500">Update your personal information</p>
        </div>

        <!-- Form -->
        <div class="space-y-4">
            <div class="flex flex-col items-center gap-3">
                <img src="/images/default-avatar.png" alt="Profile"
                     class="h-20 w-20 rounded-full border object-cover shadow-sm" />
                <button type="button"
                        class="rounded-lg border border-blue-500 px-3 py-1 text-sm font-medium text-blue-500 hover:bg-blue-50">
                    Change Photo
                </button>
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Full Name</label>
                <input type="text" placeholder="Enter your full name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                <input type="email" placeholder="Enter your email" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Mobile Number</label>
                <input type="tel" placeholder="Enter mobile number" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" />
            </div>

            <button type="button" class="w-full rounded-lg bg-blue-500 py-2 text-sm font-medium text-white shadow-md transition hover:bg-blue-600 focus:ring-2 focus:ring-blue-400 focus:outline-none">
                Save Changes
            </button>
        </div>
    </div>
</div>


