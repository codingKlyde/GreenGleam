@page "/history"
@inject AppState appState
@inject AuthService authService 
@inject IOrderApi orderApi
@inject NavigationManager navigationManager


<SectionContent SectionName="pageTitle">
    History
</SectionContent>


<div>
    @if (orderDto.Length == 0)
    {
        <div class="mt-10 flex h-full flex-col items-center justify-center space-y-4 text-center">
            <i class="fa-solid fa-cart-shopping text-7xl text-gray-300"></i>
            <div>
                <p class="text-lg font-semibold text-gray-700">Your history is empty</p>
                <p class="text-sm text-gray-500">Looks like you haven’t placed any orders yet.</p>
            </div>
            <NavLink href="/" 
                     class="rounded-lg bg-blue-500 px-6 py-2 text-sm font-medium text-white shadow transition hover:bg-blue-600">
                Continue Shopping
            </NavLink>
        </div>
    }
    else
    {
        <div class="mt-6 space-y-4">
            @foreach (var o in orderDto)
            {
                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-gray-700">#@o.Id</h3>
                        <span class="rounded-full px-3 py-1 text-xs font-medium text-white" style="background-color:@o.StatusColor">
                            @o.Status
                        </span>
                    </div>

                    <div class="mt-2 grid grid-cols-2 gap-2 text-sm text-gray-600">
                        <p>
                            <span class="font-medium text-gray-700">Date:</span>
                            @o.Date.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Items:</span>
                            @o.TotalItems
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Total:</span>
                            <span class="font-semibold text-gray-900">@o.TotalAmount.ToString("C")</span>
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Address:</span>
                            @o.AddressName
                        </p>
                    </div>
                </div>
            }
        </div>
    }
</div>



@code {
    private OrderDto[] orderDto = [];

    protected override async Task OnInitializedAsync()
    {
        if (!authService.IsLoggedIn)
        {
            if (await MauiInterop.ConfirmAsync("You need to be logged in to view your orders. Do you want to login now?", "Login Required"))
            {
                authService.RedirectFromLogin = "/orders";
                navigationManager.NavigateTo("/login", replace: true);
                return;
            }
            return;
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        appState.ShowLoader();
        try
        {
           orderDto = await orderApi.GetOrdersAsync(0, 50, authService.LoggedInUser.Id);
        }
        catch (Exception ex)
        {
            await MauiInterop.AlertAsync(ex.Message, "Error");
        }
        finally
        {
            appState.HideLoader();
        }
    }
}