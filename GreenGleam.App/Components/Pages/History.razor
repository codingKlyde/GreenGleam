@inject AppState appState
@inject AuthService authService 
@inject IOrderApi orderApi
@inject NavigationManager navigationManager
@page "/history"


<SectionContent SectionName="pageTitle">
    History
</SectionContent>


<div>
    @if (isLoading)
    {
        <div class="mt-10 flex flex-col items-center justify-center space-y-4 text-center">
            <i class="fa-solid fa-spinner fa-spin text-6xl text-blue-500"></i>
            <p class="text-lg font-semibold text-gray-700">Loading your orders...</p>
        </div>
    }
    else if (orderDto.Length == 0)
    {
        <div class="mt-10 flex h-full flex-col items-center justify-center space-y-4 text-center">
            <i class="fa-solid fa-cart-shopping text-7xl text-gray-300"></i>
            <div>
                <p class="text-lg font-semibold text-gray-700">Your history is empty</p>
                <p class="text-sm text-gray-500">Looks like you haven’t placed any orders yet.</p>
            </div>
            <NavLink href="/" class="rounded-lg bg-blue-500 px-6 py-2 text-sm font-medium text-white shadow transition hover:bg-blue-600">
                Continue Shopping
            </NavLink>
        </div>
    }
    else
    {
        <!-- Orders List -->
        <div class="mt-6 space-y-4">
            @foreach (var o in orderDto)
            {
                <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-md transition hover:shadow-lg">
                    <div class="mb-3 flex items-center justify-between">
                        <h3 class="text-xl font-bold text-gray-800">Order #@o.Id</h3>
                        <span class="rounded-full px-3 py-1 text-xs font-semibold text-white" style="background-color: @o.StatusColor">
                            @o.Status
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-sm text-gray-600">
                        <p>
                            <span class="font-medium text-gray-700">Date:</span>
                            <br />
                            @o.Date.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Items:</span>
                            <br />
                            @o.TotalItems
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Total:</span>
                            <br />
                            <span class="font-semibold text-gray-900">@o.TotalAmount.ToString("C")</span>
                        </p>
                        <p>
                            <span class="font-medium text-gray-700">Address:</span>
                            <br />
                            @o.AddressName
                        </p>
                    </div>

                    <div class="mt-4 text-right">
                        <button @onclick="() => GoToOrderDetails(o.Id)" class="rounded-xl bg-blue-500 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-blue-600 transition">
                            View Details 
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    private OrderDto[] orderDto = [];

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!authService.IsLoggedIn)
        {
            if (await MauiInterop.ConfirmAsync("You need to be logged in to view your orders. Do you want to login now?", "Login Required"))
            {
                authService.RedirectFromLogin = "/orders";
                navigationManager.NavigateTo("/login", replace: true);
                return;
            }
            return;
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        try
        {
            orderDto = await orderApi.GetOrdersAsync(0, 50, authService.LoggedInUser.Id);
        }
        catch (Exception ex)
        {
            await MauiInterop.AlertAsync(ex.Message, "Error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToOrderDetails(int orderId) => navigationManager.NavigateTo($"orders/{orderId}");
}