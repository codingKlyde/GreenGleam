@inject AppState appState
@inject CartService cartService 
@inject IProductApi productApi
@page "/"


<SectionContent SectionName="pageTitle">
    Home
</SectionContent>


<div>
    @if (isLoading)
    {
        <div class="mt-10 flex flex-col items-center justify-center space-y-4 text-center">
            <i class="fa-solid fa-spinner fa-spin text-6xl text-blue-500"></i>
            <p class="text-lg font-semibold text-gray-700">Loading products...</p>
        </div>
    }
    else
    {
        <div class="space-y-5">
            <!-- Banner -->
            <div class="relative overflow-hidden rounded-xl">
                <img src="image/background/bg2.png" alt="" class="h-40 w-full object-cover" />
                <div class="absolute inset-0 bg-black opacity-30"></div>
                <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
                    <h2 class="text-lg font-bold">Big Summer Sale</h2>
                    <p class="text-xs">Up to 50% off selected items</p>
                </div>
            </div>

            <!-- Product List -->
            <div class="grid grid-cols-2 gap-4">
                @foreach (var p in _products)
                {
                    <div class="flex flex-col space-y-2 overflow-hidden rounded-xl bg-white p-4 shadow-md transition-transform duration-150 active:scale-95">
                        <div class="aspect-square">
                            <img class="h-full w-full rounded-lg object-cover" src="@p.Image" alt="@p.Name" />
                        </div>

                        <div class="flex flex-grow flex-col">
                            <span class="truncate text-sm font-semibold">@p.Name</span>
                            <span class="text-xs font-medium text-blue-500">
                                @p.Price.ToString("C") <span class="text-gray-500">/ @p.Unit</span>
                            </span>
                        </div>

                        <div class="flex items-center space-x-2">
                            <div class="flex-grow">
                                <CartButton Product="p" />
                            </div>
                            <button class="flex h-8 w-8 items-center justify-center rounded-lg border border-blue-500 text-blue-500 transition-transform duration-150 active:scale-90">
                                <i class="fa-solid fa-info"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>



@code {
    ProductDto[] _products = [];

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        _products = await productApi.GetProductsAsync();

        foreach (var cartItem in cartService.CartItems)
        {
            var product = _products.FirstOrDefault(p => p.Id == cartItem.ProductId);
            if (product is not null)
            {
                product.Quantity = cartItem.Quantity;
            }
        }
        isLoading = false;
    }
}