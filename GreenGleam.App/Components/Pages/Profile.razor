@inject AuthService authService
@inject NavigationManager navigationManager
@page "/profile"


<SectionContent SectionName="pageTitle">
    Profile
</SectionContent>


@if (!authService.IsLoggedIn)
{
    <div class="mt-10 flex flex-col items-center justify-center space-y-4 text-center">
        <i class="fa-solid fa-user-lock text-6xl text-gray-400"></i>
        <p class="text-lg font-semibold text-gray-700">Login to view your profile</p>
        <NavLink href="/login" class="rounded-lg bg-blue-500 px-6 py-2 text-sm font-medium text-white shadow transition hover:bg-blue-600">
            Go to Login
        </NavLink>
    </div>
}
else 
{
    <div class="flex flex-col items-center gap-4">
        <!-- Profile Header -->
        <div class="w-full max-w-md rounded-xl bg-white p-4 shadow">
            <div class="flex flex-col items-center">
                <div class="flex h-20 w-20 items-center justify-center rounded-full bg-blue-100 text-blue-500">
                    <i class="fa-solid fa-user text-3xl"></i>
                </div>
                <h2 class="text-lg font-semibold text-gray-800">
                    @authService.LoggedInUser?.Name
                </h2>
                <p class="text-sm text-gray-500">@authService.LoggedInUser?.Email</p>
                  <p class="text-sm text-gray-500">@authService.LoggedInUser?.MobileNumber</p>
            </div>
        </div>

        <!-- Profile Options -->
        <div class="w-full max-w-md rounded-xl bg-white shadow">
            <NavLink href="/update-profile" class="m-4 flex items-center justify-between rounded-lg p-4 text-left hover:bg-gray-50">
                <div class="flex items-center gap-4">
                    <i class="fa-solid fa-pen-to-square text-blue-500"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-800">Edit Profile</p>
                        <p class="text-xs text-gray-500">Edit your information</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-gray-400"></i>
            </NavLink>
            <NavLink href="/change-password" class="m-4 flex items-center justify-between rounded-lg p-4 text-left hover:bg-gray-50">
                <div class="flex items-center gap-4">
                    <i class="fa-solid fa-key text-blue-500"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-800">Change Password</p>
                        <p class="text-xs text-gray-500">Update your account security</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-gray-400"></i>
            </NavLink>
            <NavLink href="/manage-addresses" class="m-4 flex items-center justify-between rounded-lg p-4 text-left hover:bg-gray-50">
                <div class="flex items-center gap-4">
                    <i class="fa-solid fa-location-dot text-blue-500"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-800">Manage Addresses</p>
                        <p class="text-xs text-gray-500">Add, edit, or delete your addresses</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-gray-400"></i>
            </NavLink>
        </div>

        <button @onclick="LogoutAsync" class="w-full max-w-md rounded-lg bg-red-500 py-2 text-sm font-medium text-white shadow transition hover:bg-red-600 focus:ring-2 focus:ring-red-400 focus:outline-none">
            Logout
        </button>
    </div>
}


@code {
    protected override async Task OnInitializedAsync()
    {
        if (!authService.IsLoggedIn)
        {
            if (await MauiInterop.ConfirmAsync("You need to be logged in to view your profile. Do you want to login now?", "Login Required"))
            {
                authService.RedirectFromLogin = "/profile";
                navigationManager.NavigateTo("/login", replace: true);
                return;
            }
            return;
        }
    }

    private async Task LogoutAsync()
    {
        if (await MauiInterop.ConfirmAsync("Do you want to logout?", "Confirmation"))
        {
            authService.Logout();
            navigationManager.NavigateTo("/", replace: true);
        }
    }
}