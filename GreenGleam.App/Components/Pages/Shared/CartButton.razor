@inject CartService CartService

@if (Product.Quantity == 0)
{
     <button @onclick="Increment" class="w-full rounded-lg bg-blue-500 py-2 text-xs text-white transition-colors duration-150 active:bg-blue-600">
        Add to Cart
    </button>
}
else
{
    <div class="flex w-full items-center justify-between rounded-lg">
        <button @onclick="Decrement"
                class="flex h-8 w-8 items-center justify-center rounded bg-red-500 text-white shadow active:bg-red-600">
            <i class="fa-solid fa-minus"></i>
        </button>

        <span class="text-center font-bold">
            @Product.Quantity
        </span>

        <button @onclick="Increment"
                class="flex h-8 w-8 items-center justify-center rounded bg-green-500 text-white shadow active:bg-green-600">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } 

    private void Decrement()
    {
        if (Product.Quantity > 0)
        {
            Product.Quantity--;
            CartService.RemoveFromCart(Product);
        }
    }

    private void Increment()
    {
        Product.Quantity++;
        CartService.AddToCart(Product);
    }
}
