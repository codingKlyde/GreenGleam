@inject CartService CartService

@if (Product.Quantity == 0)
{
     <button @onclick="IncrementAsync" class="w-full rounded-lg bg-blue-500 py-2 text-xs text-white transition-colors duration-150 active:bg-blue-600">
        Add to Cart
    </button>
}
else
{
    <div class="flex w-full items-center justify-between rounded">
        <button @onclick="DecrementAsync"
                class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-500 text-white shadow active:bg-red-600">
            <i class="fa-solid fa-minus"></i>
        </button>
        <span class="text-center font-bold">
            @Product.Quantity
        </span>
        <button @onclick="IncrementAsync"
                class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-500 text-white shadow active:bg-green-600">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } 

    private async Task DecrementAsync()
    {
        if (Product.Quantity > 0)
        {
            Product.Quantity--;
            await CartService.RemoveFromCartAsync(Product);
        }
    }

    private async Task IncrementAsync()
    {
        Product.Quantity++;
        await CartService.AddToCartAsync(Product);
    }
}
