<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GreenGleam.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GreenGleam.App.Components"
    xmlns:local="clr-namespace:GreenGleam.App"
    xmlns:service="clr-namespace:GreenGleam.App.Services"
    x:DataType="service:AppState">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent ComponentType="{x:Type components:Routes}" Selector="#app" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="#2b7fff" />
    </Grid>
</ContentPage>